# VideoGrab Environment Variables (copy to .env and fill in)

# Default output directory (overrides config default)
# VIDEOGRAB_OUTPUT_DIR=/home/you/Videos

# Default quality preset: best | 1080p | 720p | 480p | 360p | worst
# VIDEOGRAB_QUALITY=best

# Path to cookies file for authenticated downloads
# VIDEOGRAB_COOKIES=~/.config/videograb/cookies.txt

# Proxy URL
# VIDEOGRAB_PROXY=socks5://127.0.0.1:1080
